# Production Doris objects for the sdm2-deploy Job (sdm2-deploy/files/scripts/apply_prod_schema.sh).
# Not every file in schema/ is production. Do not add evaluation, POC cutover,
# or interim Routine Load SQL here. Alert tables (alert-model/schema/) ship
# only the three MVP tables; case/analysis/workflow tables are NOT deployed.
# 旧 hybrid-v1 sdm_event 通道已退役:007 建表与 026 Routine Load 已随切流完成移除,
# 唯一事件写入口为 sdm_event_behavior(031/032)。

[tables]
000_create_database.sql
006_raw_log.sql
031_sdm_event_behavior.sql
alert-model/010_sdm_alert.sql
alert-model/011_sdm_evidence.sql
alert-model/012_sdm_alert_entity.sql

[routine_load]
027_routine_load_raw_log.sql
028_routine_load_sdm_alert.sql
029_routine_load_sdm_evidence.sql
030_routine_load_sdm_alert_entity.sql
032_routine_load_sdm_event_behavior.sql
